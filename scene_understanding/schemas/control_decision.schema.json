{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lmm-autodrive/control-decision.schema.json",
  "title": "ControlDecision",
  "description": "One safety-gated action passed from scene understanding to CARLA control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "frame_id",
    "decision_status",
    "action",
    "target_speed_kmh",
    "target_lane",
    "target_location",
    "emergency",
    "reason",
    "parse_status",
    "parse_confidence",
    "source_step_id",
    "source_step_action",
    "source_step_count",
    "matched_entity_id",
    "risk_level",
    "risk_reason_codes",
    "blocked_reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "string", "minLength": 1},
    "decision_status": {"enum": ["READY", "BLOCKED", "SAFE_FALLBACK"]},
    "action": {
      "enum": [
        "keep_lane",
        "accelerate",
        "decelerate",
        "stop",
        "emergency_brake",
        "lane_change_left",
        "lane_change_right",
        "turn_left",
        "turn_right"
      ]
    },
    "target_speed_kmh": {"type": "number", "minimum": 0, "maximum": 100},
    "target_lane": {"type": ["string", "null"], "enum": [null, "left", "right"]},
    "target_location": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "z": {"type": "number"}
          }
        }
      ]
    },
    "emergency": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "parse_status": {
      "enum": ["VALID", "NEEDS_CLARIFICATION", "UNSUPPORTED", "INVALID"]
    },
    "parse_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "source_step_id": {"type": ["string", "null"], "minLength": 1},
    "source_step_action": {"type": ["string", "null"], "minLength": 1},
    "source_step_count": {"type": "integer", "minimum": 0},
    "matched_entity_id": {"type": ["string", "null"], "minLength": 1},
    "risk_level": {"enum": ["none", "low", "medium", "high"]},
    "risk_reason_codes": {"$ref": "#/$defs/stringArray"},
    "blocked_reason_codes": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
