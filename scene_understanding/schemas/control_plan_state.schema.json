{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lmm-autodrive/control-plan-state.schema.json",
  "title": "ControlPlanState",
  "description": "Persisted execution state for a multi-step DrivingIntent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "revision",
    "plan_status",
    "active_step_index",
    "active_step_id",
    "step_states",
    "last_frame_id",
    "last_feedback_outcome",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "plan_status": {
      "enum": [
        "ACTIVE",
        "COMPLETED",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "SAFE_FALLBACK"
      ]
    },
    "active_step_index": {"type": ["integer", "null"], "minimum": 0},
    "active_step_id": {"type": ["string", "null"], "minLength": 1},
    "step_states": {
      "type": "array",
      "items": {"$ref": "#/$defs/stepState"}
    },
    "last_frame_id": {"type": "string", "minLength": 1},
    "last_feedback_outcome": {
      "enum": ["INITIALIZED", "CONTINUE", "COMPLETED", "FAILED", "CANCELLED"]
    },
    "reason_codes": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stepState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "action",
        "status",
        "activation_frame_id",
        "terminal_frame_id",
        "reason_codes"
      ],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "PENDING",
            "ACTIVE",
            "WAITING",
            "COMPLETED",
            "SKIPPED",
            "BLOCKED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "activation_frame_id": {"type": ["string", "null"], "minLength": 1},
        "terminal_frame_id": {"type": ["string", "null"], "minLength": 1},
        "reason_codes": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
