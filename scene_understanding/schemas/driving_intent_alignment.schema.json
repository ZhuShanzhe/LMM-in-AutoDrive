{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmm-autodrive.local/schemas/driving_intent_alignment.schema.json",
  "title": "DrivingIntent Semantic Alignment",
  "description": "DrivingIntent多步骤指令与单帧WorldState实体的语义对齐结果。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "world_state_frame_id",
    "parse_status",
    "alignment_status",
    "target_count",
    "matched_target_count",
    "step_alignments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "world_state_frame_id": {
      "type": "string",
      "minLength": 1
    },
    "parse_status": {
      "enum": [
        "VALID",
        "NEEDS_CLARIFICATION",
        "UNSUPPORTED",
        "INVALID"
      ]
    },
    "alignment_status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "NOT_REQUIRED",
        "SKIPPED"
      ]
    },
    "target_count": {
      "type": "integer",
      "minimum": 0
    },
    "matched_target_count": {
      "type": "integer",
      "minimum": 0
    },
    "step_alignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stepAlignment"
      }
    }
  },
  "$defs": {
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_m",
        "y_m"
      ],
      "properties": {
        "x_m": {
          "type": "number"
        },
        "y_m": {
          "type": "number"
        },
        "frame": {
          "enum": [
            "EGO",
            "MAP"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "relation"
      ],
      "properties": {
        "type": {
          "enum": [
            "VEHICLE",
            "SLOW_VEHICLE",
            "PEDESTRIAN",
            "CYCLIST",
            "OBSTACLE",
            "TRAFFIC_CONE",
            "CONSTRUCTION_ZONE",
            "TRAFFIC_LIGHT",
            "TRAFFIC_SIGN",
            "CROSSWALK",
            "STOP_LINE",
            "JUNCTION",
            "LANE",
            "ROAD",
            "AREA",
            "PARKING_AREA",
            "PARKING_SPACE",
            "CURB",
            "LANDMARK",
            "DESTINATION",
            "PICKUP_POINT",
            "DROPOFF_POINT",
            "ROAD_HAZARD",
            "COORDINATE",
            "UNKNOWN"
          ]
        },
        "relation": {
          "enum": [
            "AHEAD",
            "BEHIND",
            "LEFT",
            "RIGHT",
            "FRONT_LEFT",
            "FRONT_RIGHT",
            "REAR_LEFT",
            "REAR_RIGHT",
            "AHEAD_CROSSING",
            "ADJACENT",
            "NEXT_TO",
            "IN_FRONT_OF",
            "NEAR",
            "AT_JUNCTION",
            "NEAR_DESTINATION",
            "INSIDE",
            "PAST",
            "UNSPECIFIED"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "canonical_attributes": {
          "$ref": "#/$defs/canonicalAttributes"
        },
        "open_descriptors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "coordinates": {
          "$ref": "#/$defs/coordinates"
        }
      }
    },
    "matchedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "entity_id",
        "category",
        "distance_m",
        "relative_position",
        "lane_relation",
        "risk_level"
      ],
      "properties": {
        "entity_type": {
          "enum": [
            "actor",
            "lane",
            "junction"
          ]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "distance_m": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "relative_position": {
          "enum": [
            "front",
            "front_left",
            "front_right",
            "left",
            "right",
            "rear",
            "rear_left",
            "rear_right",
            "unknown"
          ]
        },
        "lane_relation": {
          "enum": [
            "ego_lane",
            "left_adjacent_lane",
            "right_adjacent_lane",
            "oncoming_lane",
            "crossing_ego_path",
            "roadside",
            "unknown"
          ]
        },
        "risk_level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "stepAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "action",
        "target",
        "target_ref",
        "goal_conditions",
        "resolved_goal_conditions",
        "condition_entities",
        "alignment_required",
        "alignment_success",
        "candidate_count",
        "matched_entity",
        "matched_attributes",
        "missing_attributes",
        "reason_code"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/target"
            }
          ]
        },
        "alignment_required": {
          "type": "boolean"
        },
        "alignment_success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched_entity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/matchedEntity"
            }
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goalCondition"
          }
        },
        "resolved_goal_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goalCondition"
          }
        },
        "condition_entities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/matchedEntity"
          }
        },
        "matched_attributes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_attributes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "alignment_required": {
                "const": false
              }
            },
            "required": [
              "alignment_required"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "type": "null"
              },
              "alignment_success": {
                "type": "null"
              },
              "matched_entity": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "alignment_required": {
                "const": true
              }
            },
            "required": [
              "alignment_required"
            ]
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/target"
              },
              "alignment_success": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "alignment_success": {
                "const": true
              }
            },
            "required": [
              "alignment_success"
            ]
          },
          "then": {
            "properties": {
              "matched_entity": {
                "$ref": "#/$defs/matchedEntity"
              }
            }
          }
        }
      ]
    },
    "canonicalAttributes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean"
        ]
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "goalCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate",
        "subject",
        "source_span"
      ],
      "properties": {
        "predicate": {
          "enum": [
            "BEFORE",
            "AFTER",
            "BEHIND",
            "IN_FRONT_OF",
            "LEFT_OF",
            "RIGHT_OF",
            "NEAR",
            "NEXT_TO",
            "BETWEEN",
            "INSIDE",
            "PAST",
            "UNTIL",
            "VISIBLE",
            "SAFE_DISTANCE",
            "STOPPED"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "secondary_object": {
          "type": "string",
          "minLength": 1
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "source_span": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
