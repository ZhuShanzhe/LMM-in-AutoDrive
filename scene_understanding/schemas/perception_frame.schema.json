{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lmm-autodrive/perception-frame.schema.json",
  "title": "PerceptionFrame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frame_id", "source", "camera_name", "timestamp_s", "image_size", "tracks", "road_structure", "latency_ms", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "frame_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["carla", "nuscenes", "waymo", "other"]},
    "camera_name": {"type": "string", "minLength": 1},
    "timestamp_s": {"type": ["number", "null"], "minimum": 0},
    "image_size": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
    "road_structure": {"$ref": "#/$defs/roadStructure"},
    "latency_ms": {
      "type": "object", "additionalProperties": false, "required": ["detector", "total"],
      "properties": {"detector": {"type": "number", "minimum": 0}, "total": {"type": "number", "minimum": 0}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["detector", "tracker", "metric_fields_from_vlm"],
      "properties": {"detector": {"type": "string"}, "tracker": {"type": "string"}, "metric_fields_from_vlm": {"const": false}}
    }
  },
  "$defs": {
    "bbox": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}]
    },
    "track": {
      "type": "object", "additionalProperties": false,
      "required": ["track_id", "category", "subtype", "confidence", "age_frames", "bbox_2d"],
      "properties": {
        "track_id": {"type": "string", "minLength": 1},
        "category": {"enum": ["vehicle", "pedestrian", "cyclist", "motorcycle", "traffic_light", "traffic_sign", "road_barrier", "traffic_cone", "obstacle", "other"]},
        "subtype": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "age_frames": {"type": "integer", "minimum": 1},
        "bbox_2d": {"$ref": "#/$defs/bbox"}
      }
    },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "exists", "road_id", "lane_id", "lane_type", "change_legal", "dynamic_safe", "confidence"],
      "properties": {
        "direction": {"enum": ["left", "right"]}, "exists": {"type": "boolean"},
        "road_id": {"type": ["integer", "null"]}, "lane_id": {"type": ["integer", "null"]},
        "lane_type": {"type": "string"}, "change_legal": {"type": "boolean"},
        "dynamic_safe": {"enum": ["safe", "unsafe", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "roadStructure": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "safety_eligible", "ego_lane", "adjacent_lanes", "is_junction", "lane_boundaries", "drivable_area", "crosswalks", "stop_lines", "curbs", "parking_areas", "limitations"],
      "properties": {
        "source": {"type": "string"}, "safety_eligible": {"type": "boolean"},
        "ego_lane": {"type": "object"},
        "adjacent_lanes": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"$ref": "#/$defs/lane"}, "right": {"$ref": "#/$defs/lane"}}},
        "is_junction": {"type": "boolean"},
        "lane_boundaries": {"type": "array"}, "drivable_area": {"type": ["object", "null"]},
        "crosswalks": {"type": "array"}, "stop_lines": {"type": "array"}, "curbs": {"type": "array"}, "parking_areas": {"type": "array"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
