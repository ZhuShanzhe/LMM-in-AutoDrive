{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrafficControlGrounding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "source",
    "camera_name",
    "traffic_lights",
    "traffic_signs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "frame_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["nuscenes", "waymo", "carla", "other"]},
    "camera_name": {"type": "string", "minLength": 1},
    "traffic_lights": {
      "type": "array",
      "items": {"$ref": "#/$defs/traffic_light"}
    },
    "traffic_signs": {
      "type": "array",
      "items": {"$ref": "#/$defs/traffic_sign"}
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "confidence": {
      "anyOf": [
        {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "traffic_light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grounding_id", "bbox_2d", "state", "confidence"],
      "properties": {
        "grounding_id": {"type": "string", "pattern": "^tc_light_[0-9]{3,}$"},
        "bbox_2d": {"$ref": "#/$defs/bbox"},
        "state": {"enum": ["red", "yellow", "green", "off", "unknown"]},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "traffic_sign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grounding_id", "bbox_2d", "sign_type", "confidence"],
      "properties": {
        "grounding_id": {"type": "string", "pattern": "^tc_sign_[0-9]{3,}$"},
        "bbox_2d": {"$ref": "#/$defs/bbox"},
        "sign_type": {
          "enum": ["no_entry", "stop", "yield", "speed_limit", "one_way", "other", "unknown"]
        },
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    }
  }
}
