{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lmm-autodrive/risk-assessment.schema.json",
  "title": "RiskAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frame_id", "risk_level", "reason_codes", "recommended_action", "safe_following_distance_m", "object_assessments", "lane_change"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "frame_id": {"type": "string", "minLength": 1},
    "risk_level": {"$ref": "#/$defs/riskLevel"},
    "reason_codes": {"$ref": "#/$defs/stringArray"},
    "recommended_action": {"enum": ["maintain_speed", "monitor", "decelerate", "emergency_brake"]},
    "safe_following_distance_m": {"type": "number", "minimum": 0},
    "object_assessments": {"type": "array", "items": {"$ref": "#/$defs/objectAssessment"}},
    "lane_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {"$ref": "#/$defs/laneJudgment"},
        "right": {"$ref": "#/$defs/laneJudgment"}
      }
    }
  },
  "$defs": {
    "riskLevel": {"enum": ["none", "low", "medium", "high"]},
    "nullableMetric": {"type": ["number", "null"], "minimum": 0},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "objectAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "relevant_to_ego_path", "distance_m", "safe_distance_m", "distance_is_safe", "closing_speed_mps", "ttc_s", "ttc_risk_level", "risk_level", "reason_codes"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "relevant_to_ego_path": {"type": "boolean"},
        "distance_m": {"$ref": "#/$defs/nullableMetric"},
        "safe_distance_m": {"type": "number", "minimum": 0},
        "distance_is_safe": {"type": ["boolean", "null"]},
        "closing_speed_mps": {"$ref": "#/$defs/nullableMetric"},
        "ttc_s": {"$ref": "#/$defs/nullableMetric"},
        "ttc_risk_level": {"$ref": "#/$defs/riskLevel"},
        "risk_level": {"$ref": "#/$defs/riskLevel"},
        "reason_codes": {"$ref": "#/$defs/stringArray"}
      }
    },
    "laneJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "is_safe", "reason_codes", "blocking_object_ids", "closest_front_gap_m", "closest_rear_gap_m"],
      "properties": {
        "direction": {"enum": ["left", "right"]},
        "is_safe": {"type": "boolean"},
        "reason_codes": {"$ref": "#/$defs/stringArray"},
        "blocking_object_ids": {"$ref": "#/$defs/stringArray"},
        "closest_front_gap_m": {"$ref": "#/$defs/nullableMetric"},
        "closest_rear_gap_m": {"$ref": "#/$defs/nullableMetric"}
      }
    }
  }
}
