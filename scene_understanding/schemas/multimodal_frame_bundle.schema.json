{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lmm-autodrive/multimodal-frame-bundle.schema.json",
  "title": "MultimodalFrameBundle",
  "description": "One synchronized instruction, multi-view camera, LiDAR and WorldState bundle for VLA integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "request_id",
    "source",
    "frame_id",
    "simulation_frame",
    "timestamp_s",
    "synchronization",
    "instruction",
    "cameras",
    "lidar",
    "world_state",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "carla",
        "nuscenes",
        "waymo",
        "other"
      ]
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "simulation_frame": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_s": {
      "type": "number",
      "minimum": 0
    },
    "synchronization": {
      "$ref": "#/$defs/synchronization"
    },
    "instruction": {
      "$ref": "#/$defs/instruction"
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "lidar": {
      "oneOf": [
        {
          "$ref": "#/$defs/lidar"
        },
        {
          "type": "null"
        }
      ]
    },
    "world_state": {
      "$ref": "#/$defs/worldStateReference"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "matrix3x3": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "number"
      }
    },
    "matrix4x4": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "number"
      }
    },
    "imageSize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "synchronization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference_frame",
        "reference_timestamp_s",
        "tolerance_ms",
        "max_skew_ms",
        "required_modalities",
        "missing_modalities"
      ],
      "properties": {
        "status": {
          "enum": [
            "EXACT",
            "WITHIN_TOLERANCE",
            "INCOMPLETE"
          ]
        },
        "reference_frame": {
          "type": "integer",
          "minimum": 0
        },
        "reference_timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "tolerance_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_skew_ms": {
          "type": "number",
          "minimum": 0
        },
        "required_modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "text",
        "language",
        "confidence",
        "timestamp_s"
      ],
      "properties": {
        "source": {
          "enum": [
            "asr",
            "text",
            "driving_intent"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "timestamp_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensor_name",
        "frame",
        "timestamp_s",
        "image_path",
        "image_size",
        "intrinsic_matrix",
        "sensor_to_ego"
      ],
      "properties": {
        "sensor_name": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "image_path": {
          "type": "string",
          "minLength": 1
        },
        "image_size": {
          "$ref": "#/$defs/imageSize"
        },
        "intrinsic_matrix": {
          "$ref": "#/$defs/matrix3x3"
        },
        "sensor_to_ego": {
          "$ref": "#/$defs/matrix4x4"
        }
      }
    },
    "lidar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensor_name",
        "frame",
        "timestamp_s",
        "point_cloud_path",
        "point_count",
        "coordinate_frame",
        "sensor_to_ego"
      ],
      "properties": {
        "sensor_name": {
          "type": "string",
          "minLength": 1
        },
        "frame": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "point_cloud_path": {
          "type": "string",
          "minLength": 1
        },
        "point_count": {
          "type": "integer",
          "minimum": 0
        },
        "coordinate_frame": {
          "enum": [
            "sensor",
            "ego",
            "carla_world"
          ]
        },
        "sensor_to_ego": {
          "$ref": "#/$defs/matrix4x4"
        }
      }
    },
    "worldStateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "simulation_frame",
        "timestamp_s",
        "path"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "simulation_frame": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_module",
        "metric_source"
      ],
      "properties": {
        "capture_module": {
          "type": "string",
          "minLength": 1
        },
        "metric_source": {
          "enum": [
            "carla_actor_api",
            "dataset_annotation",
            "unavailable"
          ]
        }
      }
    }
  }
}
