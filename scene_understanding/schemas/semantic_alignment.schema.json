{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmm-autodrive.local/schemas/semantic_alignment.schema.json",
  "title": "Scene Understanding Semantic Alignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "reference",
    "alignment_success",
    "candidate_count",
    "matched_entity",
    "reason_code"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "frame_id": {"type": "string", "minLength": 1},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_text", "target_type", "position_hint", "lane_hint"],
      "properties": {
        "raw_text": {"type": "string"},
        "target_type": {
          "enum": [
            "pedestrian", "front_vehicle", "slow_vehicle", "vehicle",
            "left_lane", "right_lane", "junction", "traffic_light",
            "traffic_sign", "unknown"
          ]
        },
        "position_hint": {
          "enum": [
            "front", "front_left", "front_right", "left", "right",
            "rear", "rear_left", "rear_right", "unknown"
          ]
        },
        "lane_hint": {
          "enum": [
            "ego_lane", "left_adjacent_lane", "right_adjacent_lane",
            "oncoming_lane", "crossing_ego_path", "roadside", "unknown"
          ]
        }
      }
    },
    "alignment_success": {"type": "boolean"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "matched_entity": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/matchedEntity"}
      ]
    },
    "reason_code": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "matchedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_type",
        "entity_id",
        "category",
        "distance_m",
        "relative_position",
        "lane_relation",
        "risk_level"
      ],
      "properties": {
        "entity_type": {"enum": ["actor", "lane", "junction"]},
        "entity_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "distance_m": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"type": "null"}
          ]
        },
        "relative_position": {
          "enum": [
            "front", "front_left", "front_right", "left", "right",
            "rear", "rear_left", "rear_right", "unknown"
          ]
        },
        "lane_relation": {
          "enum": [
            "ego_lane", "left_adjacent_lane", "right_adjacent_lane",
            "oncoming_lane", "crossing_ego_path", "roadside", "unknown"
          ]
        },
        "risk_level": {"enum": ["none", "low", "medium", "high"]}
      }
    }
  }
}
