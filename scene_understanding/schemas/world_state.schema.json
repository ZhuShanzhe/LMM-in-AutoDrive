{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lmm-autodrive/world-state.schema.json",
  "title": "WorldState",
  "description": "One synchronized driving-world snapshot. Metric values come from CARLA or dataset annotations; VLM semantics may enrich but never replace them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "source",
    "simulation_frame",
    "timestamp_s",
    "coordinate_convention",
    "ego",
    "objects",
    "environment",
    "sensor_events",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "frame_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["carla", "nuscenes", "waymo", "other"]},
    "simulation_frame": {"type": ["integer", "null"], "minimum": 0},
    "timestamp_s": {"type": ["number", "null"], "minimum": 0},
    "coordinate_convention": {"$ref": "#/$defs/coordinateConvention"},
    "ego": {"$ref": "#/$defs/ego"},
    "objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/object"}
    },
    "environment": {"$ref": "#/$defs/environment"},
    "sensor_events": {"$ref": "#/$defs/sensorEvents"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "egoVector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitudinal", "lateral", "vertical"],
      "properties": {
        "longitudinal": {"type": "number", "description": "Positive is forward."},
        "lateral": {"type": "number", "description": "Positive is right."},
        "vertical": {"type": "number", "description": "Positive is up."}
      }
    },
    "coordinateConvention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_frame", "ego_frame", "distance_unit", "speed_unit", "acceleration_unit"],
      "properties": {
        "world_frame": {"enum": ["carla_world", "dataset_world", "unavailable"]},
        "ego_frame": {"const": "x_forward_y_right_z_up"},
        "distance_unit": {"const": "m"},
        "speed_unit": {"const": "mps"},
        "acceleration_unit": {"const": "mps2"}
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitch", "yaw", "roll"],
      "properties": {
        "pitch": {"type": "number"},
        "yaw": {"type": "number"},
        "roll": {"type": "number"}
      }
    },
    "ego": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id", "position_world_m", "rotation_world_deg", "velocity_world_mps",
        "acceleration_world_mps2", "speed_mps", "road_id", "section_id", "lane_id",
        "lane_type", "lane_change", "is_junction", "adjacent_lanes"
      ],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "position_world_m": {"$ref": "#/$defs/vector3"},
        "rotation_world_deg": {"$ref": "#/$defs/rotation"},
        "velocity_world_mps": {"$ref": "#/$defs/vector3"},
        "acceleration_world_mps2": {"$ref": "#/$defs/vector3"},
        "speed_mps": {"type": "number", "minimum": 0},
        "road_id": {"type": ["integer", "null"]},
        "section_id": {"type": ["integer", "null"]},
        "lane_id": {"type": ["integer", "null"]},
        "lane_type": {"enum": ["driving", "shoulder", "sidewalk", "biking", "parking", "restricted", "other", "unknown"]},
        "lane_change": {"enum": ["none", "left", "right", "both", "unknown"]},
        "is_junction": {"type": ["boolean", "null"]},
        "adjacent_lanes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": {"oneOf": [{"$ref": "#/$defs/adjacentLane"}, {"type": "null"}]},
            "right": {"oneOf": [{"$ref": "#/$defs/adjacentLane"}, {"type": "null"}]}
          }
        }
      }
    },
    "adjacentLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["road_id", "lane_id", "lane_type", "is_junction"],
      "properties": {
        "road_id": {"type": ["integer", "null"]},
        "lane_id": {"type": ["integer", "null"]},
        "lane_type": {"enum": ["driving", "shoulder", "sidewalk", "biking", "parking", "restricted", "other", "unknown"]},
        "is_junction": {"type": ["boolean", "null"]}
      }
    },
    "semanticMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_name", "visual_object_id", "bbox_2d", "description", "confidence"],
      "properties": {
        "camera_name": {"type": "string", "minLength": 1},
        "visual_object_id": {"type": "string", "minLength": 1},
        "bbox_2d": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "description": {"type": ["string", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id", "source_object_id", "category", "subtype", "position_world_m",
        "velocity_world_mps", "speed_mps", "relative_position_ego_m",
        "relative_velocity_ego_mps", "distance_m", "relative_longitudinal_speed_mps",
        "closing_speed_mps", "road_id", "lane_id", "lane_relation", "is_junction",
        "traffic_light_state", "semantic_matches"
      ],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "source_object_id": {"type": ["string", "null"]},
        "category": {"enum": ["vehicle", "pedestrian", "cyclist", "motorcycle", "traffic_light", "traffic_sign", "road_barrier", "traffic_cone", "animal", "other", "unknown"]},
        "subtype": {"type": "string", "minLength": 1},
        "position_world_m": {"oneOf": [{"$ref": "#/$defs/vector3"}, {"type": "null"}]},
        "velocity_world_mps": {"oneOf": [{"$ref": "#/$defs/vector3"}, {"type": "null"}]},
        "speed_mps": {"type": ["number", "null"], "minimum": 0},
        "relative_position_ego_m": {"oneOf": [{"$ref": "#/$defs/egoVector3"}, {"type": "null"}]},
        "relative_velocity_ego_mps": {"oneOf": [{"$ref": "#/$defs/egoVector3"}, {"type": "null"}]},
        "distance_m": {"type": ["number", "null"], "minimum": 0},
        "relative_longitudinal_speed_mps": {"type": ["number", "null"]},
        "closing_speed_mps": {"type": ["number", "null"], "minimum": 0},
        "road_id": {"type": ["integer", "null"]},
        "lane_id": {"type": ["integer", "null"]},
        "lane_relation": {"enum": ["ego_lane", "left_adjacent_lane", "right_adjacent_lane", "oncoming_lane", "crossing_ego_path", "roadside", "unknown"]},
        "is_junction": {"type": ["boolean", "null"]},
        "traffic_light_state": {"type": ["string", "null"], "enum": ["red", "yellow", "green", "off", "unknown", null]},
        "semantic_matches": {"type": "array", "items": {"$ref": "#/$defs/semanticMatch"}}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weather", "visibility", "road_type", "is_intersection", "precipitation_percent", "fog_density_percent", "scene_summary"],
      "properties": {
        "weather": {"enum": ["clear", "rain", "fog", "snow", "unknown"]},
        "visibility": {"enum": ["good", "reduced", "poor", "unknown"]},
        "road_type": {"enum": ["urban", "residential", "highway", "rural", "parking", "unknown"]},
        "is_intersection": {"type": ["boolean", "null"]},
        "precipitation_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "fog_density_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "scene_summary": {"type": ["string", "null"]}
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "frame", "timestamp_s", "other_actor_id", "normal_impulse_ns", "impulse_magnitude_ns"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "frame": {"type": ["integer", "null"]},
        "timestamp_s": {"type": "number", "minimum": 0},
        "other_actor_id": {"type": "string", "minLength": 1},
        "normal_impulse_ns": {"$ref": "#/$defs/vector3"},
        "impulse_magnitude_ns": {"type": "number", "minimum": 0}
      }
    },
    "laneInvasion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "frame", "timestamp_s", "crossed_lane_markings"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "frame": {"type": ["integer", "null"]},
        "timestamp_s": {"type": "number", "minimum": 0},
        "crossed_lane_markings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "sensorEvents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collisions", "lane_invasions"],
      "properties": {
        "collisions": {"type": "array", "items": {"$ref": "#/$defs/collision"}},
        "lane_invasions": {"type": "array", "items": {"$ref": "#/$defs/laneInvasion"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_source", "semantic_source", "camera_names"],
      "properties": {
        "metric_source": {"enum": ["carla_actor_api", "dataset_annotation", "unavailable"]},
        "semantic_source": {"type": ["string", "null"]},
        "camera_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
