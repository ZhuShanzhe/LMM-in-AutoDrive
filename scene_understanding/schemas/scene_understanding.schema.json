{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/lmm-autodrive/scene-understanding.schema.json",
  "title": "SceneUnderstanding",
  "description": "Structured output for single-camera keyframe understanding. Metric distance, speed, TTC and final risk are intentionally excluded and must be computed from dataset or CARLA ground truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "source",
    "camera_name",
    "scene",
    "objects",
    "potential_hazards"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique frame identifier supplied by the data loader."
    },
    "source": {
      "type": "string",
      "enum": ["nuscenes", "waymo", "carla", "other"]
    },
    "camera_name": {
      "type": "string",
      "minLength": 1,
      "description": "Camera identifier, for example CAM_FRONT or front_rgb."
    },
    "scene": {
      "$ref": "#/$defs/scene"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "potential_hazards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hazard"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scene": {
            "properties": {
              "traffic_light_state": {
                "enum": ["red", "yellow", "green"]
              }
            },
            "required": ["traffic_light_state"]
          }
        },
        "required": ["scene"]
      },
      "then": {
        "properties": {
          "objects": {
            "contains": {
              "properties": {
                "category": {
                  "const": "traffic_light"
                }
              },
              "required": ["category"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "road_type",
        "is_intersection",
        "weather",
        "visibility",
        "traffic_light_state",
        "left_lane_marking",
        "right_lane_marking"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "description": "Short evidence-based scene description."
        },
        "road_type": {
          "type": "string",
          "enum": [
            "urban",
            "residential",
            "highway",
            "rural",
            "parking",
            "unknown"
          ]
        },
        "is_intersection": {
          "type": ["boolean", "null"],
          "description": "Use null when the image is insufficient to decide."
        },
        "weather": {
          "type": "string",
          "enum": ["clear", "rain", "fog", "snow", "unknown"]
        },
        "visibility": {
          "type": "string",
          "enum": ["good", "reduced", "poor", "unknown"]
        },
        "traffic_light_state": {
          "type": "string",
          "enum": ["red", "yellow", "green", "off", "not_visible", "unknown"]
        },
        "left_lane_marking": {
          "type": "string",
          "enum": ["solid", "dashed", "double", "none", "unknown"]
        },
        "right_lane_marking": {
          "type": "string",
          "enum": ["solid", "dashed", "double", "none", "unknown"]
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "category",
        "subtype",
        "color",
        "bbox_2d",
        "relative_position",
        "lane_relation",
        "motion_state",
        "distance_level",
        "occlusion",
        "confidence"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^vlm_obj_[0-9]{3,}$",
          "description": "Temporary ID generated by the VLM, not a CARLA actor ID."
        },
        "category": {
          "type": "string",
          "enum": [
            "vehicle",
            "pedestrian",
            "cyclist",
            "motorcycle",
            "traffic_light",
            "traffic_sign",
            "road_barrier",
            "traffic_cone",
            "animal",
            "other",
            "unknown"
          ]
        },
        "subtype": {
          "type": "string",
          "description": "Optional finer class such as car, bus or truck; use unknown when unsure."
        },
        "color": {
          "type": "string",
          "description": "Simple color name or unknown."
        },
        "bbox_2d": {
          "type": "array",
          "description": "Normalized [x_min, y_min, x_max, y_max] coordinates in the range 0 to 1.",
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "relative_position": {
          "type": "string",
          "enum": [
            "front",
            "front_left",
            "front_right",
            "left",
            "right",
            "rear_left",
            "rear",
            "rear_right",
            "unknown"
          ]
        },
        "lane_relation": {
          "type": "string",
          "enum": [
            "ego_lane",
            "left_adjacent_lane",
            "right_adjacent_lane",
            "oncoming_lane",
            "crossing_ego_path",
            "roadside",
            "unknown"
          ]
        },
        "motion_state": {
          "type": "string",
          "enum": [
            "stopped",
            "parked",
            "moving_same_direction",
            "moving_toward_ego",
            "moving_away",
            "crossing",
            "unknown"
          ]
        },
        "distance_level": {
          "type": "string",
          "enum": ["near", "medium", "far", "unknown"],
          "description": "Qualitative visual estimate only; never use it to calculate TTC."
        },
        "occlusion": {
          "type": "string",
          "enum": ["none", "partial", "heavy", "unknown"]
        },
        "confidence": {
          "description": "Self-reported model confidence, or null when the grounding output does not provide one; never treat it as a calibrated probability.",
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "enum": ["traffic_light", "traffic_sign"]
              }
            },
            "required": ["category"]
          },
          "then": {
            "properties": {
              "motion_state": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "hazard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hazard_id", "related_object_ids", "description", "confidence"],
      "properties": {
        "hazard_id": {
          "type": "string",
          "pattern": "^hazard_[0-9]{3,}$"
        },
        "related_object_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^vlm_obj_[0-9]{3,}$"
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "description": "Possible visual hazard stated without inventing metric distance, TTC or final risk."
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
