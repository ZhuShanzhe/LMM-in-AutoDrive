      ]
    },
    {
      "rule_id": "R190_RESUME_REQUIRES_CONTEXT",
      "rule_type": "AMBIGUITY",
      "priority": 190,
      "description": "Use RESUME only when restoring a prior route, lane, or driving state after a temporary action. Use PROCEED for starting or continuing forward, NAVIGATE_TO for destination motion, and FOLLOW for target tracking.",
      "positive_patterns": [
