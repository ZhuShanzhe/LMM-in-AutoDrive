        "approach TARGET",
        "go to TARGET",
        "turn around",
        "wait until CONDITION",
        "back up NUMBER meters"
      ],
      "negative_patterns": [
        "follow the route without a dynamic target is PROCEED",
        "back into a parking space is PARK with parking_maneuver=REVERSE",
        "wait without a duration or condition requires clarification",
        "catch up to a stationary landmark is APPROACH"
      ],
      "output_constraints": {
        "dynamic_target_tracking": "FOLLOW",
        "generic_distance_reduction": "APPROACH",
        "destination_motion": "NAVIGATE_TO",
        "turn_around": "U_TURN",
        "conditional_hold": "WAIT",
        "independent_backward_motion": "REVERSE",
        "reverse_parking": "PARK"
      },
      "source_sample_ids": [
