    {
      "rule_id": "R200_EXTENDED_ACTION_DISTINCTION",
      "rule_type": "ACTION",
      "priority": 200,
      "description": "Map sustained or requested dynamic-target tracking to FOLLOW, generic distance reduction to APPROACH, destination motion to NAVIGATE_TO, direction reversal to U_TURN, conditional holding to WAIT, and independent backward motion to REVERSE. Reverse parking remains PARK with parking_maneuver=REVERSE.",
      "positive_patterns": [
