      ]
    },
    {
      "rule_id": "R180_DISTANCE_NOT_COORDINATE",
      "rule_type": "SLOT",
      "priority": 180,
      "description": "Extract scalar metric distance and attach it by syntactic scope to action distance, following distance, lane-change start or transition distance, or a distance trigger. Preserve x/y only when the user explicitly states a target coordinate under target.coordinates; never infer coordinates or expose a trajectory.",
      "positive_patterns": [
