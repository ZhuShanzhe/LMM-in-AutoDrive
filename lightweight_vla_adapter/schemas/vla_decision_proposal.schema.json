{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vla_decision_proposal.schema.json",
  "title": "VLADecisionProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "frame_id",
    "action",
    "target_speed_kmh",
    "target_lane",
    "target_location",
    "target_entity_id",
    "confidence",
    "model",
    "latency_ms"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "string", "minLength": 1},
    "action": {
      "enum": [
        "keep_lane",
        "accelerate",
        "decelerate",
        "stop",
        "emergency_brake",
        "lane_change_left",
        "lane_change_right",
        "turn_left",
        "turn_right"
      ]
    },
    "target_speed_kmh": {"type": "number", "minimum": 0, "maximum": 100},
    "target_lane": {"enum": [null, "left", "right"]},
    "target_location": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "z": {"type": "number"}
          }
        }
      ]
    },
    "target_entity_id": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model": {"type": "string", "minLength": 1},
    "latency_ms": {"type": "number", "minimum": 0}
  }
}
