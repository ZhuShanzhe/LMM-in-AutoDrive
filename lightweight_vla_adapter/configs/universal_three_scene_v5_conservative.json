{
  "schema_version": "4.0.0",
  "model_name": "universal-three-scene-multisensor-vla-v5-conservative",
  "camera_channels": 8,
  "lidar_channels": 4,
  "candidate_dim": 12,
  "ego_dim": 8,
  "environment_dim": 14,
  "intent_dim": 768,
  "hidden_size": 256,
  "num_layers": 4,
  "num_heads": 8,
  "dropout": 0.1,
  "bev_grid": [8, 8],
  "bev_input_size": [64, 64],
  "max_candidates": 32,
  "intent_max_length": 32,
  "num_camera_views": 4,
  "camera_input_width": 224,
  "camera_input_height": 224,
  "camera_input_fov": 100.0,
  "raw_camera_token_grid": [2, 2],
  "require_raw_camera": true,
  "use_raw_camera": true,
  "use_environment": true,
  "use_candidate_entities": true,
  "use_structured_bev": true,
  "fuse_structured_visual_risk": true,
  "condition_decision_on_visual_risk": true,
  "speed_cap_environment_index": 13,
  "allow_legacy_checkpoint": false,
  "required_modalities": [
    "text",
    "front_rgb",
    "vehicle_state",
    "environment_state"
  ],
  "scene_dependent_modalities": {
    "scene1": [],
    "scene2": ["left_rgb", "right_rgb", "rear_rgb", "lidar_bev", "candidate_entities"],
    "scene3": ["left_rgb", "right_rgb", "rear_rgb", "structured_bev", "candidate_entities"]
  },
  "deployment": {
    "precision": "fp16",
    "adapter_latency_budget_ms": 70,
    "full_decision_latency_budget_ms": 120,
    "safety_gate_scope": [
      "imminent_collision",
      "unsafe_lane_change",
      "physical_speed_bound"
    ]
  }
}
