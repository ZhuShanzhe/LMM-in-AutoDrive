{
  "schema_version": "1.0.0",
  "model_name": "lightweight-vla-modernbert-bev-base",
  "camera_channels": 8,
  "lidar_channels": 4,
  "candidate_dim": 12,
  "ego_dim": 8,
  "intent_dim": 768,
  "hidden_size": 256,
  "num_layers": 4,
  "num_heads": 8,
  "dropout": 0.1,
  "bev_grid": [8, 8],
  "max_candidates": 32,
  "intent_max_length": 32,
  "deployment": {
    "precision": "fp16",
    "adapter_latency_budget_ms": 35,
    "full_decision_latency_budget_ms": 150,
    "safety_gate_required": true
  },
  "decision_runtime": {
    "mode": "vla_first",
    "minimum_vla_confidence": 0.55,
    "maximum_source_age_s": 0.35,
    "maximum_source_skew_s": 0.15,
    "maximum_inference_latency_ms": 150.0,
    "blocked_frames_before_replan": 3,
    "maximum_streams": 128,
    "legacy_fsm_fallback_enabled": true
  }
}
