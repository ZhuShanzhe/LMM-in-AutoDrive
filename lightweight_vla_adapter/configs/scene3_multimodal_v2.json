{
  "schema_version": "2.0.0",
  "model_name": "scene3-text-raw4view-state-environment-vla-v2",
  "camera_channels": 8,
  "lidar_channels": 4,
  "candidate_dim": 12,
  "ego_dim": 8,
  "environment_dim": 12,
  "intent_dim": 768,
  "hidden_size": 256,
  "num_layers": 4,
  "num_heads": 8,
  "dropout": 0.1,
  "bev_grid": [8, 8],
  "max_candidates": 32,
  "intent_max_length": 32,
  "num_camera_views": 4,
  "camera_input_width": 224,
  "camera_input_height": 224,
  "camera_input_fov": 100.0,
  "raw_camera_token_grid": [2, 2],
  "require_raw_camera": true,
  "use_raw_camera": true,
  "use_environment": true,
  "use_candidate_entities": false,
  "use_structured_bev": false,
  "allow_legacy_checkpoint": false,
  "required_modalities": [
    "text",
    "front_rgb",
    "left_rgb",
    "right_rgb",
    "rear_rgb",
    "vehicle_state",
    "environment_state"
  ],
  "optional_modalities": ["lidar_bev"],
  "disabled_modalities": ["candidate_entities", "structured_bev"],
  "deployment": {
    "precision": "fp16",
    "adapter_latency_budget_ms": 70,
    "full_decision_latency_budget_ms": 120,
    "safety_gate_scope": [
      "imminent_collision",
      "unsafe_lane_change",
      "physical_speed_bound"
    ]
  }
}
